# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# --- APK RULES (THE MAGIC PART) ---
# 1. Ignore ALL APKs/AABs by default (to block build output)
*.apk
*.aab

# 2. BUT allow APKs only if they are inside a folder named "APK"
!**/APK/*.apk
!**/ipa/*.ipa
!**/zip/*.zip